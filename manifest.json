{
  "name": "linear-tracker",
  "title": "Linear Tracker",
  "description": "Files Barista's items as Linear issues; epics become parent issues",
  "icon": "linear",
  "version": "0.1.0",
  "settings": {
    "key": "linear-tracker",
    "label": "Linear",
    "hint": "workspace keys for filing",
    "short": "Linear keys for filing",
    "group": "Trackers",
    "find": [
      { "key": "keys", "label": "Linear API keys", "hint": "keys the Linear tracker files issues with", "keywords": "linear key token workspace tracker" }
    ]
  },
  "contributes": {
    "tracker": {
      "label": "Linear",
      "hint": "Items become Linear issues; epics are parent issues",
      "refExample": "STA-42",
      "capabilities": {
        "epics": true,
        "subIssues": true,
        "numbering": "barista",
        "branchNames": true,
        "remoteBranch": false,
        "import": true,
        "listOpen": true,
        "comments": true,
        "reopen": true
      },
      "projectFields": [
        { "key": "workspace", "label": "Workspace", "kind": "select", "options": "dynamic", "required": true },
        { "key": "team", "label": "Team", "kind": "select", "options": "dynamic", "required": true, "dependsOn": "workspace" },
        { "key": "label", "label": "Label", "kind": "text", "hint": "Added to every issue Barista files (optional)" }
      ]
    }
  }
}
